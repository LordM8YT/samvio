[Unit]
Description=Samvio web application
After=network.target mariadb.service

[Service]
Type=simple
User=samvio
Group=samvio
WorkingDirectory=/opt/samvio/app
EnvironmentFile=/etc/samvio/samvio.env
ExecStart=/usr/bin/node build
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/samvio/uploads

[Install]
WantedBy=multi-user.target
