[Unit]
Description=Samvio Vipps subscription renewal worker
After=network-online.target mariadb.service
Wants=network-online.target
Requires=mariadb.service

[Service]
Type=oneshot
User=samvio
Group=samvio
WorkingDirectory=/opt/samvio/app
EnvironmentFile=/etc/samvio/samvio.env
ExecStart=/usr/bin/node /opt/samvio/app/scripts/process-subscriptions.mjs
UMask=0077
Nice=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/samvio /opt/samvio/app

[Install]
WantedBy=multi-user.target
