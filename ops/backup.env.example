# Installer som /etc/samvio/backup.env hvis du vil overstyre standardene.
BACKUP_ROOT=/var/backups/samvio
RETENTION_DAYS=14
DB_NAME=samvio
MYSQL_CNF=/etc/samvio/mysql-backup.cnf
UPLOAD_DIR=/var/lib/samvio/uploads
APP_DIR=/opt/samvio/app

# Off-server backup med rclone. La stå tomt til en remote er satt opp.
# Eksempel: REMOTE_DEST=b2:samvio-production
REMOTE_DEST=
# Bruk en root-eid config utenfor repoet når remote aktiveres.
# RCLONE_CONFIG=/etc/samvio/rclone.conf
